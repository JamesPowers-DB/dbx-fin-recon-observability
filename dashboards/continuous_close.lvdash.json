{
  "datasets": [
    {
      "name": "ds_last_close",
      "displayName": "Last close",
      "queryLines": [
        "SELECT MEASURE(days_to_close) AS days_to_close\n",
        "FROM gold_mv_close WHERE period = date_format(add_months(current_date(), -1), 'yyyy-MM')\n"
      ]
    },
    {
      "name": "ds_active_close",
      "displayName": "Active close",
      "queryLines": [
        "SELECT MEASURE(projected_days_to_close) AS projected_days_to_close,\n",
        "       MEASURE(pre_close_completion_pct) AS pre_close_completion_pct, MEASURE(tasks_complete_pct) AS tasks_complete_pct,\n",
        "       MEASURE(tasks_overdue) AS tasks_overdue\n",
        "FROM gold_mv_close WHERE period_status = 'ACTIVE'\n"
      ]
    },
    {
      "name": "ds_close_trend",
      "displayName": "Days to close by period",
      "queryLines": [
        "SELECT period, MEASURE(days_to_close) AS days_to_close,\n",
        "       MEASURE(pre_close_completion_pct) AS pre_close_completion_pct, MEASURE(target_days_to_close) AS target_days_to_close\n",
        "FROM gold_mv_close WHERE period_status = 'CLOSED'\n",
        "GROUP BY period ORDER BY period\n"
      ]
    },
    {
      "name": "ds_controls_kpi",
      "displayName": "Controls (latest run)",
      "queryLines": [
        "SELECT MEASURE(control_pass_rate) AS control_pass_rate, MEASURE(controls_failed) AS controls_failed,\n",
        "       MEASURE(records_tested) AS records_tested\n",
        "FROM gold_mv_control_health WHERE is_latest_run = true AND period = date_format(current_date(), 'yyyy-MM')\n"
      ]
    },
    {
      "name": "ds_controls_module",
      "displayName": "Pass rate by module",
      "queryLines": [
        "SELECT module, MEASURE(control_pass_rate) AS control_pass_rate, MEASURE(controls_failed) AS controls_failed\n",
        "FROM gold_mv_control_health WHERE is_latest_run = true AND period = date_format(current_date(), 'yyyy-MM')\n",
        "GROUP BY module ORDER BY module\n"
      ]
    },
    {
      "name": "ds_exceptions_kpi",
      "displayName": "Exceptions (current close)",
      "queryLines": [
        "SELECT MEASURE(open_exceptions) AS open_exceptions, MEASURE(ai_triage_coverage_pct) AS ai_triage_coverage_pct,\n",
        "       MEASURE(critical_open_exceptions) AS critical_open_exceptions\n",
        "FROM gold_mv_exceptions WHERE period = date_format(current_date(), 'yyyy-MM')\n"
      ]
    },
    {
      "name": "ds_exceptions_sev",
      "displayName": "Open exceptions by module and AI severity",
      "queryLines": [
        "SELECT module, COALESCE(ai_severity, 'not triaged') AS ai_severity, MEASURE(open_exceptions) AS open_exceptions\n",
        "FROM gold_mv_exceptions WHERE period = date_format(current_date(), 'yyyy-MM')\n",
        "GROUP BY ALL ORDER BY module\n"
      ]
    },
    {
      "name": "ds_recon_kpi",
      "displayName": "Unreconciled (current close)",
      "queryLines": [
        "SELECT MEASURE(unreconciled_amount_usd) AS unreconciled_amount_usd, MEASURE(breaks) AS breaks\n",
        "FROM gold_mv_reconciliations WHERE period = date_format(current_date(), 'yyyy-MM')\n"
      ]
    },
    {
      "name": "ds_recon_entity",
      "displayName": "Unreconciled by entity",
      "queryLines": [
        "SELECT entity_code, recon_type, MEASURE(unreconciled_amount_usd) AS unreconciled_amount_usd\n",
        "FROM gold_mv_reconciliations WHERE period = date_format(current_date(), 'yyyy-MM')\n",
        "GROUP BY ALL ORDER BY entity_code\n"
      ]
    },
    {
      "name": "ds_key_failures",
      "displayName": "Failed key controls",
      "queryLines": [
        "SELECT control_id, control_title, MEASURE(exceptions_found) AS exceptions,\n",
        "       MEASURE(exception_amount_usd) AS exception_amount_usd\n",
        "FROM gold_mv_control_health WHERE is_latest_run = true AND key_control = true AND result = 'FAIL'\n",
        "GROUP BY control_id, control_title ORDER BY exception_amount_usd DESC\n"
      ]
    },
    {
      "name": "ds_variances",
      "displayName": "Unexplained material variances",
      "queryLines": [
        "SELECT period, entity_code, line_name, MEASURE(variance_vs_budget_usd) AS variance_vs_budget_usd\n",
        "FROM gold_mv_financials WHERE statement = 'IS'\n",
        "GROUP BY period, entity_code, line_name HAVING MEASURE(unexplained_material_variances) > 0\n",
        "ORDER BY period DESC\n"
      ]
    }
  ],
